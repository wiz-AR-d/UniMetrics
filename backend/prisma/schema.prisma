generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model University {
  id          Int          @id @default(autoincrement())
  name        String
  address     String
  users       User[]
  departments Department[]
  exams       Exam[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model User {
  id           Int          @id @default(autoincrement())
  name         String
  email        String       @unique
  password     String
  role         String       // 'SUPER_ADMIN', 'UNIVERSITY_ADMIN', 'FACULTY', 'STUDENT'
  universityId Int
  university   University   @relation(fields: [universityId], references: [id])
  grades       Grade[]
  riskProfile  RiskProfile?
  alerts       Alert[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Department {
  id           Int        @id @default(autoincrement())
  name         String
  universityId Int
  university   University @relation(fields: [universityId], references: [id])
  courses      Course[]
}

model Course {
  id               Int        @id @default(autoincrement())
  name             String
  totalAssignments Int        @default(10)
  departmentId     Int
  department       Department @relation(fields: [departmentId], references: [id])
  grades           Grade[]
}

model Exam {
  id           Int        @id @default(autoincrement())
  semester     Int
  universityId Int
  university   University @relation(fields: [universityId], references: [id])
  grades       Grade[]
}

model Grade {
  id                   Int    @id @default(autoincrement())
  marks                Float  @default(0)
  quizScore            Float  @default(0)
  labScore             Float  @default(0)
  assignmentsCompleted Int    @default(0)
  attendancePercent    Float  @default(0)

  userId   Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId Int
  course   Course @relation(fields: [courseId], references: [id])
  examId   Int
  exam     Exam   @relation(fields: [examId], references: [id])

  @@unique([userId, courseId, examId])
}

model RiskProfile {
  id        Int    @id @default(autoincrement())
  riskScore Float  @default(0)
  riskLevel String @default("LOW") // 'LOW', 'MEDIUM', 'HIGH'
  userId    Int    @unique
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Alert {
  id        Int      @id @default(autoincrement())
  message   String
  isRead    Boolean  @default(false)
  severity  String   @default("LOW") // 'LOW', 'MEDIUM', 'HIGH'
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
